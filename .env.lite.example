# Docker-free "lite" mode for backend development: SQLite + in-memory queue/event store.
# Data is lost on restart. Copy to backend/.env.
APP_ENV=development
SECRET_KEY=replace-me-with-at-least-32-random-characters-please
DATABASE_URL=sqlite:///./sentinelx.db
QUEUE_BACKEND=memory
STORE_BACKEND=memory
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@sentinelx.local
BOOTSTRAP_ADMIN_PASSWORD=
AI_PROVIDER=disabled
