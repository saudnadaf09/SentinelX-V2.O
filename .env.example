# Copy to .env (start.sh / start.bat do this and generate secrets for you).
# Never commit .env.

APP_ENV=development
# Required. 32+ random characters. start.sh/start.bat generate this automatically.
SECRET_KEY=
POSTGRES_USER=sentinelx
POSTGRES_DB=sentinelx
# Required. start.sh/start.bat generate this automatically.
POSTGRES_PASSWORD=

# First administrator, created once on first start when no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@sentinelx.local
# Leave empty to have a random password printed in the backend log, or set one (12+ chars).
BOOTSTRAP_ADMIN_PASSWORD=

WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
EVENT_RETENTION_DAYS=14
COLLECTOR_KEY_TTL_DAYS=90

# Optional AI investigator: disabled | anthropic | openai_compatible
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Only for openai_compatible (e.g. a local Ollama: http://host.docker.internal:11434/v1)
AI_BASE_URL=
